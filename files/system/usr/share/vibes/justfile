
[group('System')]

status:
    uname -r
    cat /usr/share/vibes/kernel-version
    rpm-ostree status
    flatpak --version

update:
    bootc upgrade
    flatpak update -y

reboot:
    sudo systemctl reboot

poweroff:
    sudo systemctl poweroff

journal:
    journalctl -b -n 100 --no-pager

errors:
    journalctl -b -p 3 --no-pager

boot-status:
    bootc status

disk:
    df -h / /var /boot

mem:
    free -h
    zramctl 2>/dev/null || true

kernel:
    uname -r
    cat /usr/share/vibes/kernel-version
    ls /usr/lib/modules

firmware:
    sudo fwupdmgr refresh
    sudo fwupdmgr update

services:
    systemctl list-units --failed --no-pager

service-status service:
    systemctl status "{{service}}" --no-pager

service-restart service:
    sudo systemctl restart "{{service}}"

[group('TPM')]

tpm-status:
    sudo systemd-cryptenroll --status
    tpm2_getcap handles-pcr 2>/dev/null || true

tpm-enroll device:
    sudo systemd-cryptenroll --tpm2-device=auto --tpm2-pcrs=0+7 "{{device}}"

tpm-recovery device:
    sudo systemd-cryptenroll --recovery-key "{{device}}"

tpm-pcrs:
    tpm2_getcap pcrs 2>/dev/null || true

[group('LUKS')]

luks-status:
    sudo lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINTS
    sudo cryptsetup luksDump /dev/nvme0n1p3 2>/dev/null || true

luks-header-backup device backup:
    sudo cryptsetup luksHeaderBackup "{{device}}" --header-backup-file "{{backup}}"
    echo "Restore with: sudo cryptsetup luksHeaderRestore {{device}} --header-backup-file {{backup}}"

luks-add-key device:
    sudo systemd-cryptenroll "{{device}}"

luks-remove-tpm device:
    sudo systemd-cryptenroll --wipe-slot=tpm2 "{{device}}"

[group('Gaming')]

sched-status:
    cat /sys/kernel/sched_ext/root/ops 2>/dev/null || echo "no scheduler running"
    systemctl status scx_loader --no-pager

sched-list:
    ls /usr/bin/scx_*

sched-set sched:
    sudo sed -i "s/^default_sched = .*/default_sched = \"{{sched}}\"/" /etc/scx_loader/config.toml
    sudo systemctl restart scx_loader
    cat /sys/kernel/sched_ext/root/ops 2>/dev/null || true

sched-cake:
    sudo tee /etc/scx_loader/config.toml >/dev/null <<'TOML'
default_sched = "scx_cake"
default_mode = "Gaming"

[scheds.scx_cake]
gaming_mode = ["--performance"]
lowlatency_mode = ["--performance"]
auto_mode = ["--autopilot"]
powersave_mode = ["--powersave"]
server_mode = ["--autopilot"]
TOML
    sudo systemctl restart scx_loader
    cat /sys/kernel/sched_ext/root/ops 2>/dev/null || true

sched-cosmos:
    sudo tee /etc/scx_loader/config.toml >/dev/null <<'TOML'
default_sched = "scx_cosmos"
default_mode = "Gaming"

[scheds.scx_cosmos]
gaming_mode = ["--performance"]
lowlatency_mode = ["--performance"]
auto_mode = ["--autopilot"]
powersave_mode = ["--powersave"]
server_mode = ["--autopilot"]
TOML
    sudo systemctl restart scx_loader
    cat /sys/kernel/sched_ext/root/ops 2>/dev/null || true

sched-lavd:
    sudo tee /etc/scx_loader/config.toml >/dev/null <<'TOML'
default_sched = "scx_lavd"
default_mode = "Gaming"

[scheds.scx_lavd]
gaming_mode = ["--performance"]
lowlatency_mode = ["--performance"]
auto_mode = ["--autopilot"]
powersave_mode = ["--powersave"]
server_mode = ["--autopilot"]
TOML
    sudo systemctl restart scx_loader
    cat /sys/kernel/sched_ext/root/ops 2>/dev/null || true

sched-config:
    cat /etc/scx_loader/config.toml

memory-status:
    systemctl status uresourced low-memory-monitor nohang-desktop prelockd --no-pager
    cat /etc/low-memory-monitor.conf

power-status:
    tuned-adm active
    systemctl status tuned tuned-ppd --no-pager
    cat /etc/tuned/ppd.conf

gamescope-version:
    gamescope --version

steam:
    steam >/dev/null 2>&1 &

proton-list:
    find /usr/share/steam/compatibilitytools.d -maxdepth 1 -mindepth 1 -printf '%f\n' 2>/dev/null || echo "no compatibility tools installed"

ntsync-status:
    lsmod | grep ntsync || echo "ntsync module not loaded"

[group('NVIDIA')]

nvidia-status:
    nvidia-smi

nvidia-version:
    nvidia-smi --query-gpu=driver_version --format=csv,noheader

nvidia-kmod:
    modinfo -F version nvidia
    find /usr/lib/modules/$(uname -r) -name 'nvidia*.ko*' -printf '%f\n'

gpu-watch:
    nvidia-smi dmon -d 1

[group('Flatpak')]

flatpak-update:
    flatpak update -y

flatpak-clean:
    flatpak uninstall --unused -y

flatpak-apps:
    flatpak list --app

[group('Nix')]

nix-version:
    /nix/var/nix/profiles/default/bin/nix --version

nix-gc:
    sudo /nix/var/nix/profiles/default/bin/nix-store --gc

nix-info:
    /nix/var/nix/profiles/default/bin/nix-channel --list 2>/dev/null || true
    sudo /nix/var/nix/profiles/default/bin/nix-store -q --roots /nix/var/nix/profiles

[group('Audio')]

audio-info:
    pactl info

audio-sinks:
    pactl list short sinks

[group('Hardware')]

battery:
    upower -i /org/freedesktop/UPower/devices/battery_BAT0

temps:
    sensors 2>/dev/null || echo "sensors not installed (dnf install lm_sensors)"

alias u := update
alias s := status
alias f := flatpak-update
