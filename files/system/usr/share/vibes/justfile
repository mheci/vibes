
[group('System')]
status:
    uname -r
    cat /usr/share/vibes/kernel-version
    rpm-ostree status
    flatpak --version

update:
    sudo bootc upgrade
    flatpak update -y

reboot:
    sudo systemctl reboot

poweroff:
    sudo systemctl poweroff

journal:
    journalctl -b -n 100 --no-pager

errors:
    journalctl -b -p 3 --no-pager

boot-status:
    bootc status

disk:
    df -h / /var /boot

mem:
    free -h
    zramctl 2>/dev/null || true

kernel:
    uname -r
    cat /usr/share/vibes/kernel-version
    ls /usr/lib/modules

firmware:
    sudo fwupdmgr refresh
    sudo fwupdmgr update

services:
    systemctl list-units --failed --no-pager

service-status service:
    systemctl status "{{service}}" --no-pager

service-restart service:
    sudo systemctl restart "{{service}}"

[group('TPM')]
tpm-status:
    sudo systemd-cryptenroll --status
    sudo tpm2_getcap handles-pcr 2>/dev/null || true

tpm-enroll device:
    sudo systemd-cryptenroll --tpm2-device=auto --tpm2-pcrs=0+7 "{{device}}"

tpm-recovery device:
    sudo systemd-cryptenroll --recovery-key "{{device}}"

tpm-pcrs:
    sudo tpm2_getcap pcrs 2>/dev/null || true

[group('LUKS')]
luks-status:
    sudo lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINTS
    sudo cryptsetup luksDump $(sudo lsblk -n -o NAME -I 259 | head -n1 | sed 's|^|/dev/|') 2>/dev/null || true

luks-header-backup device backup:
    sudo cryptsetup luksHeaderBackup "{{device}}" --header-backup-file "{{backup}}"
    echo "Restore with: sudo cryptsetup luksHeaderRestore {{device}} --header-backup-file {{backup}}"

luks-add-key device:
    sudo systemd-cryptenroll "{{device}}"

luks-remove-tpm device:
    sudo systemd-cryptenroll --wipe-slot=tpm2 "{{device}}"

# Encrypt a block device with LUKS2 and enroll the TPM for automatic
# unlock at boot. A passphrase key slot is kept as fallback, the device
# is added to /etc/crypttab under a stable name, and the next
# deployment regenerates the initramfs, which will then unlock the
# device automatically. All data on the device is wiped.
luks-tpm-encrypt device:
    sudo /usr/libexec/vibes-luks-tpm-encrypt.sh "{{device}}"

# Enable encrypted DNS (DNS over TLS) through systemd-resolved. The
# resolver defaults to Cloudflare (1.1.1.1, 1.0.0.1).
[group('DNS')]
dns-encrypted resolver='1.1.1.1':
    sudo /usr/libexec/vibes-dns-encrypted.sh "{{resolver}}"

dns-status:
    resolvectl status
    resolvectl query example.com | head -n 8

dns-default:
    sudo rm -f /etc/systemd/resolved.conf.d/encrypted-dns.conf
    sudo systemctl restart systemd-resolved
    echo "Encrypted DNS config removed; systemd-resolved defaults restored"

[group('Gaming')]
sched-status:
    ls /sys/kernel/sched_ext/root/ops 2>/dev/null || echo "no scheduler running"
    systemctl status scx_loader --no-pager

sched-list:
    ls /usr/bin/scx_*

sched-set sched:
    sudo sed -i "s/^default_sched = .*/default_sched = \"{{sched}}\"/" /etc/scx_loader/config.toml
    sudo systemctl restart scx_loader
    cat /sys/kernel/sched_ext/root/ops 2>/dev/null || true

sched-cake:
    sudo tee /etc/scx_loader/config.toml >/dev/null <<'TOML'
    default_sched = "scx_cake"
    default_mode = "Gaming"
    
    [scheds.scx_cake]
    gaming_mode = ["--performance"]
    lowlatency_mode = ["--performance"]
    auto_mode = ["--autopilot"]
    powersave_mode = ["--powersave"]
    server_mode = ["--autopilot"]
    TOML
    sudo systemctl restart scx_loader
    cat /sys/kernel/sched_ext/root/ops 2>/dev/null || true

sched-cosmos:
    sudo tee /etc/scx_loader/config.toml >/dev/null <<'TOML'
    default_sched = "scx_cosmos"
    default_mode = "Gaming"
    
    [scheds.scx_cosmos]
    gaming_mode = ["--performance"]
    lowlatency_mode = ["--performance"]
    auto_mode = ["--autopilot"]
    powersave_mode = ["--powersave"]
    server_mode = ["--autopilot"]
    TOML
    sudo systemctl restart scx_loader
    cat /sys/kernel/sched_ext/root/ops 2>/dev/null || true

sched-lavd:
    sudo tee /etc/scx_loader/config.toml >/dev/null <<'TOML'
    default_sched = "scx_lavd"
    default_mode = "Gaming"
    
    [scheds.scx_lavd]
    gaming_mode = ["--performance"]
    lowlatency_mode = ["--performance"]
    auto_mode = ["--autopilot"]
    powersave_mode = ["--powersave"]
    server_mode = ["--autopilot"]
    TOML
    sudo systemctl restart scx_loader
    cat /sys/kernel/sched_ext/root/ops 2>/dev/null || true

sched-config:
    cat /etc/scx_loader/config.toml

memory-status:
    systemctl status uresourced low-memory-monitor nohang-desktop prelockd --no-pager
    cat /etc/low-memory-monitor.conf

power-status:
    tuned-adm active
    systemctl status tuned tuned-ppd --no-pager
    cat /etc/tuned/ppd.conf

gamescope-version:
    gamescope --version

steam:
    steam >/dev/null 2>&1 &

steam-dev-cfg:
    mkdir -p ~/.steam/steam
    touch ~/.steam/steam/steam_dev.cfg
    grep -qxF 'unShaderBackgroundProcessingThreads 16' ~/.steam/steam/steam_dev.cfg || echo 'unShaderBackgroundProcessingThreads 16' >> ~/.steam/steam/steam_dev.cfg
    grep -qxF '@nClientDownloadEnableHTTP2PlatformLinux 0' ~/.steam/steam/steam_dev.cfg || echo '@nClientDownloadEnableHTTP2PlatformLinux 0' >> ~/.steam/steam/steam_dev.cfg
    echo "steam_dev.cfg:"
    cat ~/.steam/steam/steam_dev.cfg

proton-list:
    find /usr/share/steam/compatibilitytools.d -maxdepth 1 -mindepth 1 -printf '%f\n' 2>/dev/null || echo "no compatibility tools installed"

ntsync-status:
    lsmod | grep ntsync || echo "ntsync module not loaded"

[group('NVIDIA')]
nvidia-status:
    nvidia-smi

nvidia-version:
    nvidia-smi --query-gpu=driver_version --format=csv,noheader

nvidia-kmod:
    modinfo -F version nvidia
    find /usr/lib/modules/$(uname -r) -name 'nvidia*.ko*' -printf '%f\n'

gpu-watch:
    nvidia-smi dmon -d 1

[group('Flatpak')]
flatpak-update:
    flatpak update -y

flatpak-clean:
    flatpak uninstall --unused -y

flatpak-apps:
    flatpak list --app

[group('Nix')]
nix-version:
    /nix/var/nix/profiles/default/bin/nix --version

nix-gc:
    sudo /nix/var/nix/profiles/default/bin/nix-store --gc

nix-info:
    /nix/var/nix/profiles/default/bin/nix-channel --list 2>/dev/null || true
    sudo /nix/var/nix/profiles/default/bin/nix-store -q --roots /nix/var/nix/profiles

[group('Audio')]
audio-info:
    pactl info

audio-sinks:
    pactl list short sinks

[group('Hardware')]
battery:
    upower -i $(upower --enumerate | grep -i battery | head -n1)

temps:
    sensors 2>/dev/null || echo "sensors not installed (dnf install lm_sensors)"

alias u := update
alias s := status
alias f := flatpak-update
